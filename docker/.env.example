# =============================================================================
# Enable-LMS Enterprise — Environment Configuration Template
#
# USAGE:  cp .env.example .env   then fill in real values.
# NEVER commit .env to git — only .env.example.
# =============================================================================

# ── Django Core ──────────────────────────────────────────────────────────────
DJANGO_ENV=production
DJANGO_SETTINGS_MODULE=lms_enterprise.settings
DJANGO_SECRET_KEY=CHANGE_ME_generate_with_python_c_from_django_core_management_utils_import_get_random_secret_key_print_get_random_secret_key
DJANGO_DEBUG=false
ALLOWED_HOSTS=yourdomain.com,.yourdomain.com,localhost,127.0.0.1
LOG_LEVEL=INFO

# ── Database (External) ─────────────────────────────────────────────────────
# Point to your PostgreSQL server — hostname/IP reachable from containers.
# For a managed DB (RDS, Cloud SQL), use the endpoint hostname.
DB_HOST=db.example.com
DB_PORT=5432
DB_NAME=LMS_PROD_DB
DB_USER=lms_app_user
DB_PASSWORD=CHANGE_ME
DB_CONN_MAX_AGE=600

# ── Redis (Docker internal service name — usually leave as-is) ──────────────
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=
REDIS_MAXMEMORY=256mb

# ── Celery ───────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/3
CELERY_RESULT_BACKEND=redis://redis:6379/4
CELERY_CONCURRENCY=4
CELERY_MAX_TASKS_PER_CHILD=1000

# ── CORS & CSRF ──────────────────────────────────────────────────────────────
CORS_ORIGINS=https://yourdomain.com,http://localhost:3000
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,http://localhost:8080

# ── Cloudflare Tunnel ────────────────────────────────────────────────────────
# Get from: Cloudflare Zero Trust → Networks → Tunnels → <your tunnel> → Token
# Set the tunnel's public hostname to point to http://nginx:80 (container name).
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME

# ── Image Registry ───────────────────────────────────────────────────────────
# Leave empty for local builds.  For registry-based deploys, set the prefix:
#   IMAGE_REGISTRY=ghcr.io/yourorg/       (note trailing slash)
#   IMAGE_REGISTRY=docker.io/youruser/
IMAGE_REGISTRY=
IMAGE_TAG=latest

# ── Docker Compose Tunables ──────────────────────────────────────────────────
HTTP_PORT=8080

# ── Resource Limits ──────────────────────────────────────────────────────────
API_CPU_LIMIT=2.0
API_MEMORY_LIMIT=1G
WS_CPU_LIMIT=1.0
WS_MEMORY_LIMIT=512M
WORKER_CPU_LIMIT=2.0
WORKER_MEMORY_LIMIT=1G
BEAT_CPU_LIMIT=0.5
BEAT_MEMORY_LIMIT=256M
# =============================================================================
# Enable-LMS Enterprise — Environment Configuration Template
#
# USAGE:
#   1. Copy this file:         cp .env.example .env
#   2. Fill in the secrets:    edit .env
#   3. Deploy:                 docker compose --profile tools run --rm migrate
#                              docker compose up -d
#
# NEVER commit .env to version control. Only .env.example is safe to commit.
# =============================================================================

# ── Django Core ──────────────────────────────────────────────────────────────
DJANGO_ENV=production
DJANGO_SETTINGS_MODULE=lms_enterprise.settings
DJANGO_SECRET_KEY=CHANGE_ME_generate_with_python_c_from_django_core_management_utils_import_get_random_secret_key_print_get_random_secret_key
DJANGO_DEBUG=false
ALLOWED_HOSTS=lms.example.com,.example.com,localhost,127.0.0.1
LOG_LEVEL=INFO

# ── Database (External PostgreSQL) ───────────────────────────────────────────
# Use a DNS name for portability. Avoid hardcoded IPs.
DB_HOST=db.example.com
DB_PORT=5432
DB_NAME=LMS_PROD_DB
DB_USER=lms_app_user
DB_PASSWORD=CHANGE_ME
DB_CONN_MAX_AGE=600

# ── Redis (Docker internal) ─────────────────────────────────────────────────
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=
REDIS_MAXMEMORY=256mb

# ── Celery ───────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/3
CELERY_RESULT_BACKEND=redis://redis:6379/4
CELERY_CONCURRENCY=4
CELERY_MAX_TASKS_PER_CHILD=1000

# ── CORS & CSRF ─────────────────────────────────────────────────────────────
CORS_ORIGINS=https://lms.example.com,http://localhost:3000
CSRF_TRUSTED_ORIGINS=https://lms.example.com,http://localhost:8080

# ── Cloudflare Tunnel ────────────────────────────────────────────────────────
# Get from: Cloudflare Zero Trust → Networks → Tunnels → <your tunnel> → Install
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME

# ── Container Image Registry (optional) ─────────────────────────────────────
# Set to push/pull from a private registry, e.g. ghcr.io/your-org/
# Leave empty for local builds.
IMAGE_REGISTRY=
IMAGE_TAG=latest

# ── Docker Compose Tunables ──────────────────────────────────────────────────
HTTP_PORT=8080
API_PORT=8000
WEBSOCKET_PORT=8001

# ── Resource Limits ──────────────────────────────────────────────────────────
API_CPU_LIMIT=2.0
API_MEMORY_LIMIT=1G
WS_CPU_LIMIT=1.0
WS_MEMORY_LIMIT=512M
WORKER_CPU_LIMIT=2.0
WORKER_MEMORY_LIMIT=1G
BEAT_CPU_LIMIT=0.5
BEAT_MEMORY_LIMIT=256M
