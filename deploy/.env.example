# =============================================================================
# Enable-LMS — AceCloud deployment environment template
#
# Copy this file to deploy/.env and fill in the actual values.
# NEVER commit deploy/.env to git.
# =============================================================================

# ── AceCloud cluster / registry ────────────────────────────────────────────
ACECLOUD_REGION=<region>
CLUSTER_NAME=lms-prod-cluster
KUBECONFIG=/path/to/acecloud-kubeconfig.yaml

REGISTRY_URL=registry.internal.acecloud.io/enable-lms
REGISTRY_ROBOT_USER=<robot-username>
REGISTRY_ROBOT_TOKEN=<robot-token>

# Image tag pushed during Phase 2 — referenced by all manifests via envsubst
IMAGE_TAG=v1.0.0-20260422-120000

# ── Database VM ─────────────────────────────────────────────────────────────
DB_VM_PUBLIC_IP=45.194.90.251
DB_VM_PRIVATE_IP=10.50.10.20
DB_NAME=LMS_PROD_DB
DB_USER=lms_app_user
DB_PASSWORD=<new-strong-password-generate-fresh>
DB_SSLMODE=require

# ── Django ──────────────────────────────────────────────────────────────────
# Reuse from current /u01/app/Enable-LMS/docker/.env
DJANGO_SECRET_KEY=RNK79pTfm3gcnHQBzhMSE2Ml5yXMvQnp87afTfKAUy0VrS-hI52IEeutLDPP8cvqH24

# ── Cloudflare Tunnel ──────────────────────────────────────────────────────
# Reuse the SAME token from source — Cloudflare load-balances multiple connectors.
CLOUDFLARE_TUNNEL_TOKEN=<paste-from-current-docker/.env>

# ── Source machine (for DB dump + image build) ─────────────────────────────
SOURCE_HOST=root@192.168.1.113
SOURCE_DB_HOST=192.168.1.113
SOURCE_DB_USER=lms_app_user
SOURCE_DB_PASSWORD=LmsSecure@2024!
SOURCE_DB_NAME=LMS_PROD_DB
